<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package manifest: gives shark-notch.exe a package identity WITHOUT repackaging it.
  The exe stays where it is (the "external location"); the package only carries this manifest and
  the logos. Registered by packaging/register-identity.ps1; see docs/NOTIFICATIONS.md.

  Identity/Publisher must equal the signing certificate's subject and the <msix> element embedded
  in the exe (packaging/shark-notch.exe.manifest).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 rescap">

  <Identity Name="SharkNotch" Publisher="CN=SharkNotch" Version="0.1.0.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Shark Notch</DisplayName>
    <PublisherDisplayName>Shark Notch</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22631.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Read the user's notifications (Windows.UI.Notifications.Management.UserNotificationListener). -->
    <uap3:Capability Name="userNotificationListener" />
  </Capabilities>

  <Applications>
    <Application Id="App" Executable="shark-notch.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="Shark Notch"
        Description="An animated notch overlay for the top of the screen."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
